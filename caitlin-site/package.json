{
  "name": "matilija-family-medicine",
  "version": "0.1.0",
  "private": true,
  "description": "Prototype website for a small integrative family medicine practice in Ojai, CA",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "images": "node tools/gen-images.mjs && node tools/optimize-images.mjs",
