    "screenshots": "node tools/screenshots.mjs"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "playwright": "^1.50.0",
    "sharp": "^0.33.5"
  }
}
